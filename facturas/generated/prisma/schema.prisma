generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Factura {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  total     Float
  fecha     DateTime @default(now())
  items     Json // { productoId: number, cantidad: number, precio: number }[]

  @@map("Factura")
}
